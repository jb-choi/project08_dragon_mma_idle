    - target: {fileID: 5601499501858375827, guid: 51b832231b7393847ac756732e1a9651, type: 3}
      propertyPath: m_Text
      value: "\uC751\uC6D0: \uC804\uD22C \uC601\uC5ED \uD130\uCE58 / \uD074\uB9AD
        \uB610\uB294 SPACE \xB7 \uC2DC\uC124 \uBC84\uD2BC\uC740 \uC751\uC6D0\uC5D0
        \uD3EC\uD568\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\uD0ED\uC744 \uB2EB\uAC70\uB098
        \uD654\uBA74\uC744 \uC228\uAE30\uBA74 \uC0AC\uB0E5\uC740 \uBA48\uCDA5\uB2C8\uB2E4.
        \uB4F1\uB85D\uB41C \uD310\uB9E4\xB7\uC218\uB828 \uD0C0\uC774\uBA38\uB9CC
        \uC644\uB8CC\uB429\uB2C8\uB2E4.\n\uC9C4\uD589 \uC0C1\uD669\uC740 \uD604\uC7AC
        \uAE30\uAE30\xB7\uBE0C\uB77C\uC6B0\uC800\uC5D0 \uC800\uC7A5\uB429\uB2C8\uB2E4.
        \uB2E4\uB978 \uAE30\uAE30\uC640 \uC790\uB3D9 \uACF5\uC720\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5601499501858375827, guid: 51b832231b7393847ac756732e1a9651, type: 3}
